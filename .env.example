# Runtime
APP_ENV=development
BIND_ADDRESS=0.0.0.0:3000
RUST_LOG=prosepect_api=debug,tower_http=info

# PostgreSQL
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://prosepect:change-me@localhost:5432/prosepect
DATABASE_MAX_CONNECTIONS=10

# Browser access
CORS_ALLOWED_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
ALLOW_INSECURE_DEV_AUTH=true
# Set true for hosted deployments where only pre-provisioned account_invites may sign in.
INVITE_ONLY=false
# Optional hard account capacity. Existing users can still sign in after the limit is reached.
MAX_USER_ACCOUNTS=
# Owner Operations access: comma-separated existing account UUIDs, never email addresses.
# Empty/unset denies everyone; malformed values fail startup. See docs/OPERATIONS.md.
ADMIN_USER_IDS=
# Only enable when the API is exclusively reachable through a trusted reverse proxy.
TRUST_PROXY_HEADERS=false

# Google authentication and calendar synchronization
# Generate TOKEN_ENCRYPTION_KEY with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Optional bearer token for remote one-shot synchronization triggers. Use at least 32 random characters.
WORKER_TRIGGER_TOKEN=

# Optional Discord integration (configure all four together; see docs/DISCORD-INTEGRATION.md).
# Never prefix secrets with VITE_ or commit actual credentials.
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_REDIRECT_URI=
# Vercel relay only: full HTTPS API endpoint, e.g. https://api.example.com/webhooks/discord.
DISCORD_BACKEND_URL=

# File storage
# Leave all S3 variables empty in development to use FILE_STORAGE_PATH instead.
FILE_STORAGE_PATH=./data/files
MAX_FILE_SIZE_BYTES=26214400
# Per-account quota. Defaults to the global quota when omitted.
MAX_USER_FILE_STORAGE_BYTES=104857600
# Global quota across every tenant. The hosted service uses 5 GiB to remain below R2's free allowance.
MAX_TOTAL_FILE_STORAGE_BYTES=5368709120
# Internal API endpoint and browser-reachable endpoint may differ in containers.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=prosepect
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=prosepect
S3_SECRET_ACCESS_KEY=change-me
S3_ALLOW_HTTP=true
# Set true only when S3_ENDPOINT uses a bucket-specific virtual hostname.
S3_VIRTUAL_HOSTED_STYLE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
# Optional public HTTPS endpoint for near-real-time Google Calendar notifications.
GOOGLE_CALENDAR_WEBHOOK_URL=
